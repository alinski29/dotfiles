{
  "extends": [
    "nolabs-ai/pi"
  ],
  "meta": {
    "name": "pi",
    "version": "",
    "description": null,
    "author": null
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "approval_backends": {},
    "approval_defaults": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [
      {
        "name": "linux_temp_read",
        "when": "linux"
      }
    ],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    "allow": [
      "$HOME/package.json",
      "$HOME/.agent-browser",
      "$HOME/.pi-lens",
      "$HOME/.local/state/nvim",
      "$HOME/.npm",
      "$HOME/go",
      "$HOME/node_modules",
      "/tmp/pi-scratchpad",
      "/tmp/pi-editor",
      "/tmp/pi-subagents-uid-$UID",
      "/proc/sys/vm/overcommit_memory",
      "$XDG_DATA_HOME/nvim",
      "$XDG_DATA_HOME/gon/pkg/mod",
      "$XDG_DATA_HOME/cargo",
      "$XDG_CONFIG_HOME/astro",
      "$XDG_CACHE_HOME/huggingface"
    ],
    "read": [
      "/tmp/jiti",
      "/tmp/node-compile-cache",
      "/tmp/pi-rtk-optimizer",
      "/etc/host.conf",
      "$XDG_CONFIG_HOME/rpiv-i18n",
      "$DOTFILES_HOME/nono/gh-sandbox",
      "$XDG_DATA_HOME/rtk",
      "$XDG_DATA_HOME/gon",
      "$HOME/.herdr/worktrees",
      "$HOME/.local/state/herdr/client",
      "$HOME/.pi/agent/npm/node_modules/pi-subagents",
      "$HOME/.docker",
      "$DOTFILES_HOME/.agents/skills",
      "$DOTFILES_HOME/neovim",
      "$DOTFILES_HOME/nono/gh-sandbox",
      "$XDG_CACHE_HOME/docproc",
      "/usr/include",
      "/usr/lib",
      "/usr/lib32",
      "/usr/lib64",
      "/usr/bin"
    ],
    "write": [],
    "allow_file": [],
    "read_file": [],
    "write_file": [],
    "unix_socket": [
      "$XDG_RUNTIME_DIR/sandbox/wayland-0"
    ],
    "unix_socket_bind": [],
    "unix_socket_dir": [
      "$XDG_CONFIG_HOME/herdr",
      "$DOTFILES_HOME/pi/agent/intercom",
      "/tmp/piab-$UID"
    ],
    "unix_socket_dir_bind": [
      "$XDG_RUNTIME_DIR/sandbox"
    ],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [
      "$XDG_CONFIG_HOME/zsh-secrets",
      "$XDG_CONFIG_HOME/zsh/secrets.env"
    ],
    "bypass_protection": [],
    "suppress_save_prompt": []
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [
      "*"
    ],
    "deny_domain": [],
    "credentials": [
      "github",
      "github-git",
      "opencode",
      "openrouter",
      "exa",
      "gemini"
    ],
    "open_port": [],
    "open_port_range": [
      [
        3000,
        3010
      ],
      [
        3333,
        3333
      ],
      [
        4200,
        4331
      ],
      [
        5173,
        5183
      ],
      [
        8080,
        8090
      ],
      [
        8787,
        8787
      ],
      [
        9222,
        9242
      ]
    ],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "cmd://github",
        "inject_mode": "header",
        "inject_header": "Authorization",
        "credential_format": "token {}",
        "env_var": "GH_TOKEN"
      },
      "github-git": {
        "upstream": "https://github.com",
        "credential_key": "cmd://github",
        "inject_mode": "basic_auth",
        "credential_format": "x-access-token:{}",
        "env_var": "GH_TOKEN"
      },
      "opencode": {
        "upstream": "https://opencode.ai/zen/go/v1",
        "credential_key": "env://OPENCODE_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
        "env_var": "OPENCODE_API_KEY"
      },
      "openrouter": {
        "upstream": "https://openrouter.ai/api/v1",
        "credential_key": "env://OPENROUTER_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
        "env_var": "OPENROUTER_API_KEY"
      },
      "exa": {
        "upstream": "https://api.exa.ai",
        "credential_key": "env://EXA_API_KEY",
        "inject_mode": "header",
        "inject_header": "x-api-key",
        "credential_format": "{}",
        "env_var": "EXA_API_KEY"
      },
      "gemini": {
        "upstream": "https://generativelanguage.googleapis.com",
        "credential_key": "env://GEMINI_API_KEY",
        "inject_mode": "header",
        "inject_header": "x-goog-api-key",
        "credential_format": "{}",
        "env_var": "GEMINI_API_KEY"
      }
    },
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": []
  },
  "diagnostics": {
    "suppress_system_services": []
  },
  "linux": {
    "af_unix_mediation": null,
    "sandbox_policy": "landlock"
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "USER",
      "HOSTNAME",
      "LOGNAME",
      "SHELL",
      "TERM",
      "TERM_PROGRAM",
      "COLORTERM",
      "LANG",
      "LC_*",
      "TZ",
      "TMPDIR",
      "XDG_*",
      "HERDR_*",
      "PI_*",
      "NONO_*",
      "SSH_AUTH_SOCK",
      "EDITOR",
      "VISUAL",
      "PAGER",
      "NIX_*",
      "SSL_CERT_FILE",
      "DOTFILES_HOME"
    ],
    "set_vars": {
      "XDG_RUNTIME_DIR": "$XDG_RUNTIME_DIR/sandbox",
      "WAYLAND_DISPLAY": "$XDG_RUNTIME_DIR/sandbox/wayland-0",
      "GH_CONFIG_DIR": "~/.dotfiles/nono/gh-sandbox",
      "GIT_CONFIG_NOSYSTEM": "1",
      "AGENT_BROWSER_ARGS": "--no-sandbox,--disable-dev-shm-usage,--ozone-platform-hint=auto",
      "AGENT_BROWSER_EXECUTABLE_PATH": "$HOME/.local/bin/agent-browser-chrome",
      "AGENT_BROWSER_NO_XVFB": "1",
      "WRANGLER_LOG_PATH": "$HOME/.cache/wrangler",
      "WRANGLER_SEND_METRICS": "false"
    }
  },
  "credential_capture": {
    "github": {
      "command": [
        "gh",
        "auth",
        "token"
      ],
      "timeout_secs": 5,
      "cache_ttl_secs": 900,
      "cache_path_regex": "^/(?:repos/|orgs/)?([^/]+)"
    }
  },
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "readwrite"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [
      "node_modules",
      ".npm/_logs/",
      ".next",
      "__pycache__",
      "target",
      ".pi",
      ".pi-subagents",
      "dist",
      "build",
      ".venv",
      "vendor",
      ".turbo",
      ".cache",
      "/tmp/pi-subagents-uid-",
      "/tmp/pi-subagents-uid-1000",
      "/tmp/pi-scratchpad",
      "/tmp/pi-editor",
      "$HOME/.agent-browser/",
      "$HOME/.local/state/nvim/",
      "$HOME/.npm/",
      "$HOME/.pi-lens",
      "$HOME/go",
      "$HOME/node_modules",
      "$XDG_DATA_HOME/nvim/",
      "$XDG_DATA_HOME/gon",
      "$XDG_DATA_HOME/cargo/",
      "$DOTFILES_HOME/pi/web-search-cache/",
      "$DOTFILES_HOME/pi/agent/pi-blackhole/",
      "$DOTFILES_HOME/pi/agent/sessions/",
      "$DOTFILES_HOME/pi/agent/intercom/",
      "$DOTFILES_HOME/pi/agent/missions/",
      "$DOTFILES_HOME/pi/agent/run-history.jsonl",
      "$DOTFILES_HOME/pi/agent/models-store.json",
      "$DOTFILES_HOME/pi/agent/pi-speeed-stats.json",
      "$XDG_CACHE_HOME/huggingface"
    ],
    "exclude_globs": [
      "*.tmp.[0-9]*.[0-9]*",
      "*.mdb",
      "*.pid"
    ]
  },
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
}
