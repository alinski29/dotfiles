// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
    "opencode": {
      "show_zen_models": false,
    },
  },
  "prettier": {
    "parser": "",
    "allowed": true,
  },
  "format_on_save": "off",
  "tab_size": 2,
  "file_finder": {
    "include_ignored": "all",
  },
  "debugger": {
    "dock": "right",
  },
  "proxy": "",
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "split",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "JetBrains New UI Icons (Dark)",
  },
  "seed_search_query_from_cursor": "never",
  "agent_servers": {
    "pi-acp": {
      "default_mode": "high",
      "type": "registry",
    },
    "github-copilot-cli": {
      "default_config_options": {
        "model": "gpt-5.4-mini",
      },
      "type": "registry",
    },
  },
  "context_servers": {},
  "collaboration_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right",
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://github\\.com",
            },
          ],
        },
        "mcp:mcp-server-context7:query-docs": {
          "default": "allow",
        },
      },
    },
    "default_profile": "write",
    "default_model": {
      "effort": "medium",
      "provider": "copilot_chat",
      "model": "gpt-5.4-mini",
      "enable_thinking": true,
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "project_panel": {
    "dock": "right",
  },
  "vim_mode": true,
  "terminal": {
    "show_count_badge": false,
    "font_family": "JetBrainsMono Nerd Font Mono",
  },
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "never",
  },
  "buffer_font_fallbacks": [
    "JetBrainsMono Nerd Font Mono",
    "RobotoMono Nerd Font Mono",
    "DankMono Nerd Font",
    "Monaco Nerd Font Mono",
  ],
  "buffer_font_family": "CommitMono Nerd Font",
  "ui_font_size": 16,
  "buffer_font_size": 13.5,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Nightfox - opaque",
  },
  "lsp": {
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore",
          },
        },
      },
    },
    "protobuf-language-server": {
      "binary": {
        "path": "buf",
        "arguments": ["beta", "lsp"],
      },
    },
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": {
            "typeCheckingMode": "standard",
            "diagnosticMode": "workspace",
            "inlayHints": {
              "callArgumentNames": false,
              "reportArgumentType": false,
            },
          },
        },
      },
    },
  },
  "languages": {
    // "TypeScript": {
    //   "language_servers": ["vtsls"],
    // },
    // "TSX": {
    //   "language_servers": ["vtsls"],
    // },
    // "JavaScript": {
    //   "language_servers": ["vtsls"],
    // },
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
      ],
    },
    "TSX": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
      ],
    },
    "JavaScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
      ],
    },
    "Go": {
      "formatter": "language_server",
      "format_on_save": "on",
    },
    "Proto": {
      "formatter": "language_server",
      "format_on_save": "on",
    },
    "CSS": {
      "language_servers": ["tailwindcss-laguage-server"],
    },
    "Python": {
      // "language_servers": ["ty", "!basedpyright"]
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "Nix": {
      "language_servers": ["nixd"],
    },
    // "Svelte": {
    //   "prettier": {
    //     "allowed": false,
    //   },
    // },
  },
}
